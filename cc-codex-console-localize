#!/usr/bin/python3
"""Prepare a missing shared console; attaching to a live console never restarts it."""
import fcntl
import os
import subprocess
import sys

def _user_name():
    """Пользователь ОС консоли Codex: config.json «codex_user», иначе codex."""
    import json
    try:
        with open('/opt/cc-limits/config.json', encoding='utf-8') as f:
            return str(json.load(f).get('codex_user') or '').strip() or 'codex'
    except (OSError, ValueError):
        return 'codex'


USER_NAME = _user_name()


def screen_pid():
    sys.path.insert(0, '/opt/cc-limits')
    import cc_codex_console
    cc_codex_console.cc_codex.RUN_AS = USER_NAME
    value = cc_codex_console._pid()
    return int(value) if value else None


def run(args, **kwargs):
    return subprocess.run(args, check=True, text=True, capture_output=True, **kwargs)


def processes():
    rows = []
    for line in run(['/usr/bin/ps', '-eo', 'pid=,ppid=,tty=,args=']).stdout.splitlines():
        values = line.strip().split(None, 3)
        if len(values) == 4:
            rows.append((int(values[0]), int(values[1]), values[2], values[3]))
    return rows


def fail(message):
    print(message, file=sys.stderr)
    raise SystemExit(1)


def start_console():
    sys.path.insert(0, '/opt/cc-limits')
    import cc_limits
    ok, message = cc_limits.cc_codex_console.start(lang='ru')
    print(message)
    return ok


def main():
    if screen_pid():
        return
    for _pid, _parent, tty, args in processes():
        is_cli = ('node_modules/.bin/codex' in args or '/vendor/' in args) and 'app-server' not in args
        if is_cli and tty != '?':
            fail('Сначала закрой отдельное окно Codex. Затем снова запусти cxw для подключения к общей консоли.')
    if not start_console():
        fail('Не удалось запустить общую консоль Codex.')
    print('Готово: cxw подключится к общей консоли Codex.')


def entry():
    # A live attachment is read-only and must work without a writable /run/lock.
    if screen_pid():
        return
    with open('/run/lock/cc-codex-console-transition.lock', 'a') as transition_lock:
        fcntl.flock(transition_lock, fcntl.LOCK_EX)
        main()


def check():
    if not screen_pid():
        fail('Общая консоль Codex не найдена.')


if __name__ == '__main__':
    if sys.argv[1:] == ['--check']:
        check()
    elif sys.argv[1:]:
        fail('Неизвестный аргумент помощника cxw.')
    else:
        entry()

[Unit]
Description=Notion AI: общий чат Telegram -> постоянный чат Notion (профиль «Notion AI · только он»)
After=network-online.target notion-delegate.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /root/notion_web/notion_ai_tg.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=Notion AI chat viewer for balancer console (read-only, on-demand)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/notion_web/notion_ai_view.py
WorkingDirectory=/root/notion_web
Environment=HTTPS_PROXY= HTTP_PROXY= https_proxy= http_proxy= PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
Nice=5

[Install]
WantedBy=multi-user.target

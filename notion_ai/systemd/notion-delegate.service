[Unit]
Description=Notion AI: отправка в постоянный чат и вход в Notion (notion-delegate, 127.0.0.1:8893)
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/root/notion_web
Environment=HTTPS_PROXY= HTTP_PROXY= https_proxy= http_proxy= NODE_EXTRA_CA_CERTS=
ExecStart=/usr/bin/python3 /root/notion_web/server.py
Restart=on-failure
RestartSec=10
[Install]
WantedBy=multi-user.target

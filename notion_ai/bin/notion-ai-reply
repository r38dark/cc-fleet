#!/usr/bin/env python3
"""notion-ai-reply [--agent "имя агента"] [--voice "что озвучить"] [--no-voice] [--file путь ...] "текст" | -
--agent: ответ от имени агента — в его чат Telegram (⚙ в окне агента; пусто — основной чат) и с пометкой «[имя]» в начале текста и голоса.
--chat id: явный чат (проверка). --test: отправить пробное сообщение и напечатать {"ok":..., "error":...}.
[notion-ai] 05.11.26. Ответ Notion AI владельцу в общий чат Telegram (бот Claude, chat_id из /opt/cc-limits/config.json):
текст + голос локальным TTS cc-fleet (ccfleet-say из voice/install.sh; на серверах с ручной установкой — /root/tts/say.sh), голос kseniya.
Для кода, логов и длинных отчётов озвучивать краткое резюме через --voice. «-» — текст из stdin."""
import argparse
import json
import urllib.error
import mimetypes
import os
import re
import subprocess
import sys
import time
import urllib.request
import uuid

ENV = "/root/.claude/channels/telegram/.env"
CFG = "/opt/cc-limits/config.json"
LOG = "/root/notion_web/notion_ai_tg.log"


def token():
    return re.search(r"TELEGRAM_BOT_TOKEN=(\S+)", open(ENV).read()).group(1)


NAI_CFG = "/opt/cc-limits/notion_ai.json"  # [notion-ai] ⚙ Настройки → Notion AI в панели


def nai_cfg():
    try:
        return json.load(open(NAI_CFG)) or {}
    except Exception:
        return {}


NAGENTS = "/root/notion_web/nagents.json"  # реестр агентов (пишет сервис notion-delegate)


def agent_entry(name):
    """Запись агента из реестра по имени (или по прежнему имени после переименования); None — не найден."""
    want = " ".join(str(name or "").split()).lower()
    if not want:
        return None
    try:
        reg = json.load(open(NAGENTS)).get("agents") or {}
    except Exception:
        return None
    for a in reg.values():
        names = [a.get("name")] + list(a.get("old_names") or [])
        if any(" ".join(str(n or "").split()).lower() == want for n in names):
            return a
    return None


def chat_id(agent=None):
    own = str((agent or {}).get("tg_chat_id") or "").strip()  # свой чат агента (форма создания / окно агента)
    if own:
        return own
    cid = str(nai_cfg().get("tg_chat_id") or "").strip()  # свой чат для Notion AI; пусто — как у Claude
    if cid:
        return cid
    try:
        return str(json.load(open(CFG)).get("chat_id") or "")   # chat_id задаёт установщик (config.json)
    except Exception:
        return ""


def api(method, payload, timeout=30):
    req = urllib.request.Request("https://api.telegram.org/bot%s/%s" % (token(), method), data=json.dumps(payload).encode(),
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def upload(method, field, path, extra, timeout=120):
    boundary = uuid.uuid4().hex
    body = b""
    for k, v in extra.items():
        body += ("--%s\r\nContent-Disposition: form-data; name=\"%s\"\r\n\r\n%s\r\n" % (boundary, k, v)).encode()
    mime = mimetypes.guess_type(path)[0] or "application/octet-stream"
    body += ("--%s\r\nContent-Disposition: form-data; name=\"%s\"; filename=\"%s\"\r\nContent-Type: %s\r\n\r\n"
             % (boundary, field, os.path.basename(path), mime)).encode() + open(path, "rb").read() + ("\r\n--%s--\r\n" % boundary).encode()
    req = urllib.request.Request("https://api.telegram.org/bot%s/%s" % (token(), method), data=body,
                                 headers={"Content-Type": "multipart/form-data; boundary=" + boundary})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def chunks(text, n=3900):
    out = []
    while len(text) > n:
        cut = text.rfind("\n", 0, n)
        cut = cut if cut > n // 2 else n
        out.append(text[:cut])
        text = text[cut:].lstrip("\n")
    return out + ([text] if text.strip() else [])


def voice_text(text):
    t = re.sub(r"```.*?```", " ", text, flags=re.S)
    t = re.sub(r"`([^`]*)`", r"\1", t)
    t = re.sub(r"https?://\S+", "ссылка", t)
    t = re.sub(r"[*_#>|]+", " ", t)
    t = re.sub(r"\s+", " ", t).strip()
    if len(t) > 1200:
        cut = max(t.rfind(". ", 0, 1200), t.rfind("! ", 0, 1200), t.rfind("? ", 0, 1200))
        t = t[:cut + 1] if cut > 300 else t[:1200]
    return t


def say_tool():
    """Команда озвучки: ccfleet-say от установщика голоса, иначе прежний /root/tts/say.sh."""
    for p in ("/usr/local/bin/ccfleet-say", "/root/tts/say.sh"):
        if os.path.exists(p):
            return p
    return "/usr/local/bin/ccfleet-say"


def tts_ok():
    try:
        with urllib.request.urlopen("http://127.0.0.1:8879/health", timeout=4) as r:
            return b"ok" in r.read().lower()
    except Exception:
        return False


def log(msg):
    try:
        with open(LOG, "a") as f:
            f.write(time.strftime("%d.%m %H:%M:%S ") + "reply: " + msg + "\n")
    except OSError:
        pass


def main():
    ap = argparse.ArgumentParser(description="Ответ Notion AI в общий чат Telegram (текст + голос)")
    ap.add_argument("text", nargs="*")
    ap.add_argument("--voice", help="текст для озвучки (по умолчанию — сам ответ без кода)")
    ap.add_argument("--no-voice", action="store_true")
    ap.add_argument("--file", action="append", default=[], help="приложить файл/картинку")
    ap.add_argument("--agent", default="", help="имя агента: чат Telegram берётся из его настроек, в начале — пометка [имя]")
    ap.add_argument("--chat", default="", help="явный чат (для проверки)")
    ap.add_argument("--test", action="store_true", help="пробное сообщение; итог — одна строка JSON")
    a = ap.parse_args()
    ent = agent_entry(a.agent) if a.agent else None
    cid = a.chat.strip() or chat_id(ent)
    tag = ("[%s] " % " ".join(a.agent.split())) if a.agent.strip() else ""
    if a.test:
        if not cid:
            print(json.dumps({"ok": False, "chat": "", "error": "нет chat_id: укажи его в config.json или в настройках Notion AI"}, ensure_ascii=False))
            return
        try:
            api("sendMessage", {"chat_id": cid, "text": "%s✅ Проверка: сюда будет отвечать агент «%s»." % (tag, a.agent or "Notion AI")})
            print(json.dumps({"ok": True, "chat": cid}, ensure_ascii=False))
        except urllib.error.HTTPError as e:
            try:
                err = json.load(e).get("description") or "HTTP %s" % e.code
            except Exception:
                err = "HTTP %s" % e.code
            hint = " — проверь id чата и что бот добавлен в этот чат (в канале — администратором)" if "chat not found" in err.lower() or e.code in (400, 403) else ""
            print(json.dumps({"ok": False, "chat": cid, "error": err + hint}, ensure_ascii=False))
        except Exception as e:
            print(json.dumps({"ok": False, "chat": cid, "error": type(e).__name__}, ensure_ascii=False))
        return
    text = " ".join(a.text).strip()
    if text == "-" or (not text and not sys.stdin.isatty()):
        text = sys.stdin.read().strip()
    if not text and not a.file:
        ap.error("нет текста")
    res = {"text": 0, "files": 0, "voice": False}
    if not cid:
        sys.exit("нет chat_id: укажи его в /opt/cc-limits/config.json (\"chat_id\") или в настройках Notion AI")
    for i, part in enumerate(chunks(text)):
        api("sendMessage", {"chat_id": cid, "text": (tag + part) if i == 0 else part})
        res["text"] += 1
    for path in a.file:
        img = (mimetypes.guess_type(path)[0] or "").startswith("image/") and os.path.getsize(path) < 10 * 1024 * 1024
        upload("sendPhoto" if img else "sendDocument", "photo" if img else "document", path, {"chat_id": cid})
        res["files"] += 1
    if not a.no_voice and nai_cfg().get("voice", True) is not False:  # голос выключают в настройках
        vt = voice_text(a.voice or text)
        if vt and a.agent.strip():
            vt = "Отвечает %s. %s" % (" ".join(a.agent.split()), vt)
        if vt and tts_ok():
            out = "/tmp/notion_ai_voice_%d.ogg" % int(time.time() * 1000)
            try:
                r = subprocess.run([say_tool(), vt, out, "kseniya"], capture_output=True, text=True, timeout=240)
                if r.returncode == 0 and os.path.exists(out):
                    upload("sendVoice", "voice", out, {"chat_id": cid})
                    res["voice"] = True
            finally:
                if os.path.exists(out):
                    os.remove(out)
    log(json.dumps(res))
    print(json.dumps(res, ensure_ascii=False))


if __name__ == "__main__":
    main()

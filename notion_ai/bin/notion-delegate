#!/usr/bin/env python3
"""notion-delegate "задание" | -f файл | code 123456 | status | rotate | on | off
Поручить работу агенту Notion (чат «2») и получить готовый результат. Для Codex (песочница без сети) задание уходит файлом
в папку .notion-delegate в РАБОЧЕЙ папке; для Claude — HTTP 127.0.0.1:8893. Ждёт ответ до NOTION_DELEGATE_WAIT секунд (1500)."""
import os, sys, json, time, uuid, urllib.request, urllib.error
HOME = os.path.expanduser("~")
CODEX = os.environ.get("NOTION_DELEGATE_SPOOL") == "1" or (os.getuid() != 0 and HOME.startswith("/home/"))   # Codex работает от отдельного пользователя ОС (не root)
def tok():
    for p in (os.path.join(HOME, ".notion_delegate_token"), "/root/.notion_delegate_token"):
        try: return open(p).read().strip()
        except OSError: pass
    sys.exit("нет токена ~/.notion_delegate_token")
def call(path, data=None):
    r = urllib.request.Request("http://127.0.0.1:8893" + path, data=json.dumps(data).encode() if data is not None else None, headers={"X-Token": tok(), "Content-Type": "application/json"})
    try: return json.load(urllib.request.urlopen(r, timeout=30))
    except urllib.error.HTTPError as e: return json.load(e)
def spool(kind, text, wait):
    base = os.path.join(os.getcwd(), ".notion-delegate")
    try:
        for d in ("in", "out"): os.makedirs(os.path.join(base, d), exist_ok=True)
    except OSError as e: sys.exit("рабочая папка недоступна для записи: %s" % e)
    name = uuid.uuid4().hex[:10]; tmp = f"{base}/in/{name}.tmp"
    open(tmp, "w").write(text); os.rename(tmp, f"{base}/in/{name}.{kind}"); out = f"{base}/out/{name}.result"; t0 = time.time()
    while time.time() - t0 < wait:
        if os.path.exists(out):
            r = open(out).read()
            try: os.unlink(out)
            except OSError: pass
            return r
        time.sleep(4)
    sys.exit("нет ответа за %d с: задание %s может ещё выполняться, ответ появится в %s" % (wait, name, out))
def main():
    a = sys.argv[1:]
    if not a: sys.exit(__doc__)
    wait = float(os.environ.get("NOTION_DELEGATE_WAIT", "1500"))
    if a[0] == "status": print(urllib.request.urlopen("http://127.0.0.1:8893/health", timeout=10).read().decode()); return
    if a[0] in ("on", "off"): print(call("/" + a[0], {})); return
    if a[0] == "rotate": print(call("/rotate", {})); return
    if a[0] == "code":
        c = (a[1] if len(a) > 1 else "").strip()
        print(spool("code", c, 60) if CODEX else call("/code", {"code": c})); return
    task = open(a[1]).read() if a[0] == "-f" else " ".join(a)
    if CODEX: print(spool("task", task, wait)); return
    j = call("/delegate", {"task": task, "source": "claude"})
    if j.get("error"): sys.exit("ОШИБКА: " + str(j["error"]))
    t0 = time.time()
    while time.time() - t0 < wait:
        time.sleep(4); r = call("/job/" + j["id"])
        if r.get("status") == "done":
            p = r.get("partial"); print((f"[ОТВЕТ НЕПОЛНЫЙ: {p if isinstance(p, str) else 'время вышло'}]\n" if p else "") + (r.get("result") or "")); return
        if r.get("status") == "error": sys.exit("ОШИБКА: " + str(r.get("error")))
    sys.exit("нет ответа за %d с, задание %s в работе: GET /job/%s" % (wait, j["id"], j["id"]))
main()

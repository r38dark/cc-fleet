#!/usr/bin/env python3
"""notion-ai-step [--rights дев|чтение] (текст | -)   — [notion-ai] шаг оркестратора Notion AI → исполнитель.
Шаг уходит владельцу на подтверждение (кнопки в Telegram и в панели); после «Выполнить» его делает исполнитель
профиля «Notion AI → Codex», результат приходит в чат Notion AI и в /root/notion_ai_inbox/step_<id>.md.
notion-ai-step --status   — текущий шаг и его статус."""
import json
import sys
import urllib.request

args = sys.argv[1:]
cfg = json.load(open("/opt/cc-limits/config.json"))
base = "http://127.0.0.1:%s/api/notion-ai" % cfg.get("port", 8877)
hdr = {"X-CC-Token": cfg.get("hook_token", ""), "Content-Type": "application/json"}


def call(url, body=None):
    req = urllib.request.Request(url, data=json.dumps(body).encode() if body is not None else None, headers=hdr)
    with urllib.request.urlopen(req, timeout=120) as r:
        return json.load(r)


if not args or args[0] in ("-h", "--help"):
    sys.exit(__doc__)
if args[0] == "--status":
    st = call(base)
    print(json.dumps(dict(profile=st.get("title"), active=st.get("active"), step=st.get("step")), ensure_ascii=False, indent=1))
    sys.exit(0)
rights = "dev"
if args[0] == "--rights":
    rights = {"дев": "dev", "dev": "dev", "чтение": "read", "read": "read"}.get((args[1:2] or [""])[0].lower())
    if not rights:
        sys.exit("права: дев или чтение")
    args = args[2:]
text = sys.stdin.read() if args == ["-"] or not args else " ".join(args)
r = call(base + "/step", {"text": text, "rights": rights, "by": "notion-ai-step"})
print(json.dumps({k: r.get(k) for k in ("ok", "id", "message")}, ensure_ascii=False))
sys.exit(0 if r.get("ok") else 1)

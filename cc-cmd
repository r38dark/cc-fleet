#!/bin/bash
# cc-cmd — консольные команды балансера cc-fleet на любом сервере, где он стоит:
#   cl   — зайти в консоль Claude (нет сессии — создать, продолжив прошлый разговор)
#   cla  — только подключиться к живой сессии Claude
#   cln  — создать НОВУЮ сессию Claude (если есть живая — спросит, убивать ли)
#   clw  — вернуться в рабочую сессию Claude (жива — подключиться, иначе пересоздать с --resume); clw -f — пересоздать
#   cxw  — подключиться к общей screen-сессии Codex, принимающей сообщения балансера и Telegram
# Ссылки cl/cla/cln/clw/cxw в /usr/local/bin создаёт сам балансер при старте (cc_limits.ensure_cmd_links) и сам обновляет с релизом.
# Настройки — из config.json балансера (рядом с этим файлом):
#   screen_session — имя screen-сессии Claude (по умолчанию claude)
#   claude_cmd     — как запускать Claude, целиком (по умолчанию просто claude),
#                    например: IS_SANDBOX=1 claude --dangerously-skip-permissions --channels plugin:telegram@claude-plugins-official
#   codex_user     — под кем живёт консоль Codex (по умолчанию codex)

self=$(readlink -f "$0")
name=$(basename "$0")
if [ "$name" = "cc-cmd" ]; then
    name=${1:-}
    shift
fi
CONF="${CC_LIMITS_BASE:-$(dirname "$self")}/config.json"

# значение ключа из config.json; нет ключа, пусто или файл не читается — запасное
cfgget() {
    python3 -c 'import json,sys
try:
    v = json.load(open(sys.argv[1])).get(sys.argv[2])
except Exception:
    v = None
print(v.strip() if isinstance(v, str) and v.strip() else sys.argv[3])' "$CONF" "$1" "$2" 2>/dev/null || echo "$2"
}

need_screen() {
    command -v screen >/dev/null 2>&1 && return 0
    echo "Не нашёл screen — поставь его (например: apt install screen)."
    exit 1
}

# имя сессии кладём в регулярку и в аргументы screen — оставляем только безопасные символы
SESS=$(cfgget screen_session claude)
case "$SESS" in
    *[!A-Za-z0-9_.-]*|"") SESS=claude ;;
esac
CMD=$(cfgget claude_cmd claude)

alive() {
    screen -wipe >/dev/null 2>&1
    screen -ls 2>/dev/null | grep -qE "[0-9]+\.${SESS}[[:space:]]"
}

# запустить сессию с готовой строкой запуска и подключиться
launch() {
    screen -S "$SESS" -dm bash -lc "$1"
    sleep 1
    screen -r "$SESS"
}

# [remote] 06.11: работа передана на PROD - бота слушает Claude там, здесь новую сессию не создаём.
remote_on() {
    python3 -c 'import json,sys
try:
    sys.exit(0 if json.load(open(sys.argv[1])).get("active") else 1)
except Exception:
    sys.exit(1)' "$(dirname "$CONF")/remote_mode.json" 2>/dev/null || return 1
    echo "Работа сейчас на PROD - Claude здесь не запускаю: бота Telegram слушает Claude на PROD."
    echo "Сначала верни работу: кнопка «Вернуть мне» в панели у плитки «Аккаунт PROD». Потом снова $name."
    return 0
}

inside_screen() {
    [ -z "$STY" ] && return 1
    echo "Ты ВНУТРИ screen ($STY). Сначала detach: Ctrl+A, потом d. Затем $name."
    return 0
}

case "$name" in
    cl)
        need_screen
        if alive; then
            exec screen -DR "$SESS"
        fi
        remote_on && exit 1
        launch "$CMD --continue || $CMD"
        ;;
    cla)
        need_screen
        if alive; then
            exec screen -DR "$SESS"
        fi
        echo "screen-сессия $SESS не найдена. Используй cln, чтобы создать новую."
        exit 1
        ;;
    cln)
        need_screen
        remote_on && exit 1
        if alive; then
            read -r -p "screen $SESS уже существует. Убить и создать новую? [y/N] " ans </dev/tty
            case "$ans" in
                y|Y|yes) screen -S "$SESS" -X quit; sleep 1 ;;
                *) echo "Отмена. Используй cla, чтобы подключиться к существующей."; exit 1 ;;
            esac
        fi
        launch "CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1 $CMD"
        ;;
    clw)
        need_screen
        inside_screen && exit 1
        # screen жив, но Claude внутри вышел (остался голый bash) — это не «жив», пересоздаём
        if [ "$1" != "-f" ] && alive && pgrep -f '(^|/)claude( |$)|claude-code/' >/dev/null; then
            echo "$SESS жив — переподключаюсь (пересоздать с нуля: clw -f)"
            exec screen -rd "$SESS"
        fi
        remote_on && exit 1
        screen -S "$SESS" -X quit 2>/dev/null
        sleep 1
        launch "CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1 $CMD --resume"
        ;;
    cxw)
        inside_screen && exit 1
        u=$(cfgget codex_user codex)
        sname="${1:-cc-codex}"
        case "$sname" in *[!A-Za-z0-9_-]*|"") exit 2 ;; esac
        codex_home=$(getent passwd "$u" | cut -d: -f6)
        if [ -z "$codex_home" ]; then
            echo "Пользователь $u не найден (config.json → codex_user)."
            exit 1
        fi
        if [ -x /usr/local/sbin/cc-codex-console-localize ]; then
            if [ "$(id -u)" = 0 ]; then
                /usr/local/sbin/cc-codex-console-localize || exit $?
            else
                sudo -n /usr/local/sbin/cc-codex-console-localize || exit $?
            fi
        fi
        base="$(dirname "$self")"
        cx_transport() {
            transport=$(python3 "$base/cc_codex_terminal.py" "$base" "$codex_home/codex_console") || return $?
            mapfile -t terminal <<< "$transport"
            screen_bin="${terminal[0]}"
            screen_dir="${terminal[1]}"
            [ -x "$screen_bin" ] || return 1
            run=(env -u SCREENDIR HOME="$codex_home" TERM="${TERM:-xterm-256color}")
            [ -n "$screen_dir" ] && run+=(SCREENDIR="$screen_dir")
            [ "$(id -u)" = 0 ] && run=(/usr/sbin/runuser -u "$u" -- "${run[@]}")
            return 0
        }
        cx_pid() {
            "${run[@]}" "$screen_bin" -ls 2>/dev/null |
                sed '/Dead/d' | sed -nE "s/^[[:space:]]*([0-9]+)\.${sname}[[:space:]].*/\1/p" | head -n 1
        }
        cx_new_pending() {
            [ "$sname" = cc-codex ] || return 1
            # /new saves its intent before closing Screen. A completed restart
            # has a new PID; this also covers its first message already being accepted.
            # Other exits (detach, /stop, SSH disconnect) must leave the client.
            python3 - "$codex_home/codex_console/console.json" "$connected_pid" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as stream:
        meta = json.load(stream)
    pending = (meta.get('pending_settings') or {}).get('new_session')
    replacement_pid = str(meta.get('pid') or '')
    replaced = replacement_pid.isdigit() and replacement_pid != sys.argv[2]
except (OSError, ValueError, AttributeError):
    sys.exit(1)
sys.exit(0 if pending or replaced else 1)
PY
        }
        if ! cx_transport; then
            echo "Не найден Screen для текущей консоли Codex."
            exit 1
        fi
        connected_pid=$(cx_pid)
        if [ -z "$connected_pid" ]; then
            echo "Консоль Codex не запущена (screen $sname нет)."
            echo "Запусти её на странице балансера: вкладка Codex → «Запустить». Потом снова cxw."
            exit 1
        fi
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 143' TERM
        while :; do
            echo "Подключаюсь к $sname (пользователь $u). Выйти, не останавливая Codex: Ctrl+A, потом d."
            "${run[@]}" "$screen_bin" -rd "$connected_pid.$sname"
            attach_status=$?
            cx_transport || exit "$attach_status"
            current_pid=$(cx_pid)
            [ "$current_pid" = "$connected_pid" ] && exit "$attach_status"
            cx_new_pending || exit "$attach_status"
            echo "Новая сессия Codex — переподключаюсь…"
            deadline=$((SECONDS + 15))
            while [ "$SECONDS" -lt "$deadline" ]; do
                if cx_transport; then
                    current_pid=$(cx_pid)
                    if [ -n "$current_pid" ] && [ "$current_pid" != "$connected_pid" ]; then
                        break
                    fi
                fi
                current_pid=""
                sleep 0.2
            done
            if [ -z "$current_pid" ]; then
                echo "Новая консоль Codex не запустилась. Проверь её состояние в балансере."
                exit 1
            fi
            connected_pid=$current_pid
        done
        ;;
    *)
        echo "cc-cmd: команды cl, cla, cln, clw (Claude) и cxw (Codex). Запускай их по имени, например: cl"
        exit 2
        ;;
esac
